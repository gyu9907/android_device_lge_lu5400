#
# system.prop for lu5400
#

# Define modem related settings
rild.libpath=/system/lib/lge-ril.so
rild.libargs=-d /dev/ttyspi3
ro.telephony.ril_class=P2RIL
ro.telephony.call_ring.multiple=false
ro.telephony.call_ring.delay=3000
ro.telephony.call_ring.absent=true
persist.radio.rr.enable=1

# audio
omap.audio.mic.main=AMic0
omap.audio.mic.sub=AMic1
omap.audio.power=PingPong

# Used for automagic internal configs
ro.build.target_country=EU
ro.build.target_operator=OPEN

# BT address path
ro.bt.bdaddr_path=/sys/devices/platform/bd_address/bdaddr_if

# nfc
ro.nfc.port=I2C

# OMAP4/SGX cannot reliably map GPU-rendered TILER buffers for CPU reads.
# Force SurfaceFlinger screenshots through the glReadPixels fallback.
ro.bq.gpu_to_cpu_unsupported=1

# Legacy camera HAL: use Camera1 in the CM12.1 portability layer (300c5aec).
camera2.portability.force_api=1

# LU540141 GPS HAL uses the MDM6600 TS0710 channel /dev/pts9.
ro.hardware.gps=omap4
