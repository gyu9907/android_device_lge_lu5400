# GFX
/dev/dsscomp                    u:object_r:video_device:s0
/dev/gcioctl                    u:object_r:gpu_device:s0
/system/vendor/bin/pvrsrvinit   u:object_r:pvrsrvinit_exec:s0
/system/vendor/bin/pvrsrvinit_SGX540_120  u:object_r:pvrsrvinit_exec:s0

# Sensors
# Legacy MPL runs in system_server; preserve its existing calibration bytes.
/persist/cal\.bin               u:object_r:system_data_file:s0
/dev/timerirq                  u:object_r:sensors_device:s0
/data/misc/sens/fifo_dat        u:object_r:sensors_device:s0
/data/misc/sens/fifo_cmd        u:object_r:sensors_device:s0
/data/misc/sens/profile_calib_a      u:object_r:sensors_device:s0
/data/misc/sens/profile_calib_m      u:object_r:sensors_device:s0

# radio
/dev/xmd-.*                      u:object_r:radio_device:s0
/dev/xmd-tty6                    u:object_r:gps_device:s0

# Vibrator
/dev/tspdrv                      u:object_r:input_device:s0

# for wpa_supp
/dev/rfkill                      u:object_r:rfkill_device:s0

/system/bin/pvrsrvinit\.lu5400    u:object_r:pvrsrvinit_exec:s0

# LU5400 Bluetooth UART and board-specific rfkill power controls.
/dev/ttyO1                     u:object_r:hci_attach_dev:s0
/sys/devices/platform/lbee9qmb-rfkill\.0/rfkill/rfkill[0-9]+/state u:object_r:sysfs_bluetooth_writable:s0

# Stock LG bootloader message partition and its single-purpose writer.
/dev/block/mmcblk0p6                  u:object_r:lu5400_misc_block_device:s0
/system/bin/prepare-recovery\.lu5400  u:object_r:lu5400_recovery_prep_exec:s0

# LU540141 modem nodes; GPS channel uses the existing GPS policy.
/dev/ttyspi[0-3]                 u:object_r:radio_device:s0
/dev/pts[0-9]+                   u:object_r:radio_device:s0
/dev/pts9                       u:object_r:gps_device:s0
